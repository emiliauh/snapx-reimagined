<Window
    Background="Transparent"
    CanResize="False"
    Closed="OnClosed"
    Cursor="Cross"
    Focusable="True"
    IsVisible="False"
    KeyDown="OnKeyDown"
    Opacity="0"
    ShowInTaskbar="False"
    SystemDecorations="None"
    Title="RegionSelectorWindow"
    Topmost="True"
    WindowState="Normal"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="SnapX.Avalonia.Views.RegionSelectorWindow"
    x:DataType="viewModels:RegionSelectorViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:SnapX.Avalonia.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.DataContext>
        <viewModels:RegionSelectorViewModel />
    </Design.DataContext>
    <Grid x:Name="RootGrid">
        <Canvas
            Background="Transparent"
            Cursor="Cross"
            PointerMoved="OnPointerMoved"
            PointerPressed="OnPointerPressed"
            PointerReleased="OnPointerReleased"
            x:Name="Canvas">
            <Rectangle
                IsHitTestVisible="False"
                Stroke="{DynamicResource SystemAccentColorDark1}"
                StrokeThickness="2"
                x:Name="SelectionRect" />
            <Panel
                Height="21"
                IsHitTestVisible="False"
                IsVisible="False"
                Width="21"
                x:Name="CursorMarker">
                <Rectangle
                    Fill="{DynamicResource SystemAccentColorDark1}"
                    Height="3"
                    HorizontalAlignment="Stretch"
                    Stroke="{DynamicResource SystemChromeWhiteColor}"
                    StrokeThickness="1"
                    VerticalAlignment="Center" />
                <Rectangle
                    Fill="{DynamicResource SystemAccentColorDark1}"
                    HorizontalAlignment="Center"
                    Stroke="{DynamicResource SystemChromeWhiteColor}"
                    StrokeThickness="1"
                    VerticalAlignment="Stretch"
                    Width="3" />
            </Panel>
            <TextBox
                Background="{DynamicResource SystemAccentColorDark3}"
                BorderThickness="0"
                Foreground="{DynamicResource SystemChromeWhiteColor}"
                HorizontalAlignment="Left"
                IsHitTestVisible="False"
                IsReadOnly="True"
                Padding="5"
                VerticalAlignment="Top"
                x:Name="InfoBox" />
        </Canvas>
        <Panel
            HorizontalAlignment="Stretch"
            IsHitTestVisible="False"
            VerticalAlignment="Stretch"
            ZIndex="50"
            x:Name="LiveAnnotateHost" />
        <Border
            Background="#CC252526"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            CornerRadius="3"
            HorizontalAlignment="Center"
            IsHitTestVisible="True"
            IsVisible="False"
            Padding="2,1"
            VerticalAlignment="Top"
            ZIndex="100"
            x:Name="LiveToolbarHost" />
    </Grid>
</Window>
