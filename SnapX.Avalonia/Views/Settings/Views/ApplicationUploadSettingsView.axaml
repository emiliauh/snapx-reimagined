<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="SnapX.Avalonia.Views.Settings.Views.ApplicationUploadSettingsView"
    x:DataType="settings:ApplicationUploadSettingsVM"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:SnapX.Avalonia.ViewModels.Settings"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.DataContext>
        <settings:ApplicationUploadSettingsVM />
    </Design.DataContext>
    <ScrollViewer>
        <StackPanel Margin="24" Spacing="12" MaxWidth="760">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Application upload" />
            <TextBlock Opacity="0.75" Text="Set upload rules that apply to all tasks." TextWrapping="Wrap" />

            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Upload behavior" />
                    <CheckBox Content="Disable uploads" IsChecked="{Binding DisableUpload}" />
                    <CheckBox Content="Ignore emoji while URL encoding" IsChecked="{Binding UrlEncodeIgnoreEmoji}" />
                    <CheckBox Content="Show the first upload warning" IsChecked="{Binding ShowUploadWarning}" />
                    <CheckBox Content="Show the multi-file upload warning" IsChecked="{Binding ShowMultiUploadWarning}" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Upload limits" />
                    <Grid ColumnDefinitions="230,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Retry count" />
                        <TextBox Grid.Column="1" Text="{Binding MaxUploadFailRetryText, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Large-file warning (MB)" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LargeFileWarningText, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Concurrent upload limit" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UploadLimitText, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock FontSize="12" Opacity="0.7" Text="Set the large-file warning to 0 to disable it." TextWrapping="Wrap" />
                    <Button Command="{Binding SaveSettingsCommand}" Content="Save upload settings" HorizontalAlignment="Left" />
                    <TextBlock FontSize="12" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
