<UserControl
    d:DesignHeight="700"
    d:DesignWidth="900"
    mc:Ignorable="d"
    x:Class="SnapX.Avalonia.Views.Settings.Views.ScreenRecordOptionsView"
    x:DataType="settings:ScreenRecordOptionsVM"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:SnapX.Avalonia.ViewModels.Settings"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.DataContext>
        <settings:ScreenRecordOptionsVM />
    </Design.DataContext>
    <ScrollViewer Padding="24">
        <StackPanel Spacing="18" MaxWidth="900">
            <StackPanel Spacing="4">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="Screen recorder" />
                <TextBlock Opacity="0.75" Text="Set capture timing, FFmpeg devices, codecs, and command templates." TextWrapping="Wrap" />
                <TextBlock FontSize="12" Opacity="0.65" Text="{Binding RecorderSummary}" />
            </StackPanel>

            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Recording behavior" />
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Video frames per second" />
                        <NumericUpDown Grid.Column="1" Maximum="240" Minimum="1" Value="{Binding FramesPerSecond}" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="GIF frames per second" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Maximum="60" Minimum="1" Value="{Binding GifFramesPerSecond}" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Start delay (seconds)" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StartDelayText}" />
                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Fixed duration (seconds)" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DurationText}" />
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="Capture the mouse cursor" IsChecked="{Binding ShowCursor}" />
                        <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Content="Start recording after region selection" IsChecked="{Binding AutoStart}" />
                        <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Content="Use a fixed recording duration" IsChecked="{Binding FixedDuration}" />
                    </Grid>
                    <CheckBox Content="Use two-pass encoding" IsChecked="{Binding TwoPassEncoding}" />
                    <CheckBox Content="Ask before aborting" IsChecked="{Binding AskConfirmationOnAbort}" />
                    <CheckBox Content="Capture a transparent region" IsChecked="{Binding TransparentRegion}" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="FFmpeg input and codecs" />
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Video source" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding VideoSources}" SelectedItem="{Binding SelectedVideoSource}" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Audio source" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AudioSources}" SelectedItem="{Binding SelectedAudioSource}" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Video codec" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding VideoCodecs}" SelectedItem="{Binding VideoCodec}" />
                        <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Audio codec" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AudioCodecs}" SelectedItem="{Binding AudioCodec}" />
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="x264 preset" />
                        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding VideoPreset}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="FFmpeg executable" />
                    <CheckBox Content="Override automatic FFmpeg discovery" IsChecked="{Binding OverrideCliPath}" />
                    <Grid ColumnDefinitions="200,*" RowDefinitions="Auto">
                        <TextBlock VerticalAlignment="Center" Text="Executable path" />
                        <TextBox Grid.Column="1" Text="{Binding CliPath}" IsEnabled="{Binding OverrideCliPath}" Watermark="/usr/bin/ffmpeg" />
                    </Grid>
                    <TextBlock FontSize="12" Opacity="0.65" Text="When override is disabled, SnapX searches the bundled executable and PATH." TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="6" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Advanced command options" />
                    <CheckBox Content="Use a custom FFmpeg command template" IsChecked="{Binding UseCustomCommands}" />
                    <TextBox AcceptsReturn="True" Height="120" Text="{Binding CustomCommands}" IsEnabled="{Binding UseCustomCommands}" Watermark="Use $fps$, $area_x$, $area_y$, $area_width$, $area_height$, $cursor$, $duration$, and $output$." />
                    <TextBlock Text="Additional FFmpeg arguments" />
                    <TextBox Text="{Binding UserArguments}" Watermark="Enter optional arguments." />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Command="{Binding SaveSettingsCommand}" Content="Save settings" />
                <Button Command="{Binding ResetSettingsCommand}" Content="Reset recorder settings" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
