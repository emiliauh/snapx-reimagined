<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SnapX.Avalonia.Views.Settings.Views.UploaderToolTips">

      <StackPanel Spacing="2">
          <TextBlock FontWeight="Bold" Text="Available placeholders:" Foreground="{DynamicResource SystemAccentColor}"/>
          <TextBlock xml:space="preserve" FontSize="12">
  <Run FontWeight="Bold">{response}</Run>: Response text
  <Run FontWeight="Bold">{responseurl}</Run>: Response or redirection URL
  <Run FontWeight="Bold">{header:name}</Run>: Response header
  <Run FontWeight="Bold">{json:path}</Run>: Read JSON with JSONPath
  <Run FontWeight="Bold">{xml:path}</Run>: Read XML with XPath
  <Run FontWeight="Bold">{regex:pattern|group}</Run>: Read text with a regular expression
  <Run FontWeight="Bold">{filename}</Run>: Original file name
  <Run FontWeight="Bold">{random:a|b}</Run>: Select a random value
  <Run FontWeight="Bold">{base64:input}</Run>: Encode as Base64</TextBlock>
      </StackPanel>
        <!-- These are not implemented by my UI frontends yet. -->
          <!-- <Run FontWeight="Bold">{select:a|b}</Run>: User selection -->
  <!-- <Run FontWeight="Bold">{inputbox:title|default}</Run>: Ask the user for input
  <Run FontWeight="Bold">{outputbox:title|text}</Run>: Show output -->
</UserControl>
