<?xml version='1.0' encoding='utf-8'?>
<component type="desktop-application">
  <!--Created with jdAppStreamEdit 9.0-->
  <!-- Semantic-release should generate Version changelogs -->
  <id>io.emiliauh.SnapXL.SnapX</id>
  <name>SnapX</name>
  <summary>Capture, share, and manage screenshots</summary>
  <developer id="io.emiliauh">
    <name>emiliauh</name>
    <web>https://github.com/emiliauh</web>
  </developer>
  <metadata_license>GFDL-1.3-or-later</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>SnapX is a free, open source application for screen capture and recording.</p>
    <p>Use one key to capture or record an area of the screen.</p>
    <p>Upload images, videos, and text to supported destinations.</p>
    <p>SnapX is based on ShareX. It is not an official ShareX release.</p>
  </description>
  <screenshots>
    <screenshot type="default">
      <caption>The home screen</caption>
    <image type="source">https://raw.githubusercontent.com/emiliauh/snapx-reimagined/main/.github/Screenshot.webp</image>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/emiliauh/snapx-reimagined</url>
  <url type="bugtracker">https://github.com/emiliauh/snapx-reimagined/issues</url>
  <categories>
    <category>Utility</category>
    <category>Graphics</category>
  </categories>
  <recommends>
    <internet>always</internet>
    <control>pointing</control>
    <control>keyboard</control>
  </recommends>
  <supports>
    <control>console</control>
    <control>voice</control>
  </supports>
  <content_rating type="oars-1.1">
    <content_attribute id="social-info">moderate</content_attribute>
  </content_rating>
  <launchable type="desktop-id">io.emiliauh.SnapXL.SnapX.desktop</launchable>
  <provides>
    <id>io.emiliauh.SnapXL.SnapX.desktop</id>
    <binary>snapx-ui</binary>
  </provides>
  <keywords>
    <keyword>sharex</keyword>
    <keyword>sharenix</keyword>
    <keyword>sharexen</keyword>
    <keyword>share</keyword>
    <keyword>imgur</keyword>
    <keyword>screenshot</keyword>
    <keyword>ocr</keyword>
    <keyword>gif</keyword>
    <keyword>ftp</keyword>
    <keyword>sftp</keyword>
    <keyword>video</keyword>
  </keywords>
